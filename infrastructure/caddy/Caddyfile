# ImobOS edge: the only service that publishes ports (ADR 0003, ADR 0005).
# Every value comes from the environment; nothing host-specific or secret lives in this file.
{
	email {$ACME_EMAIL}
}

{$IMOBOS_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# A private tool: keep it out of search engines even if a URL leaks.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Basic auth in front of everything except the privacy page Google requires to be public, and
	# the static assets that page loads (build output, nothing user-specific). It goes away at the
	# V1C-90 cutover. OAuth callbacks and webhooks (V1C-85) get exact paths, never /api/* whole.
	@private not path /privacidade /_next/static/* /favicon.ico
	basic_auth @private {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	reverse_proxy web:3000
}
