# ImobOS edge: the only service that publishes ports (ADR 0003, ADR 0005).
# Every value comes from the environment; nothing host-specific or secret lives in this file.
{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# A private tool: keep it out of search engines even if a URL leaks.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}

{$IMOBOS_DOMAIN} {
	encode zstd gzip
	import security_headers

	# No basic auth since V1C-90: the application authenticates (Google) and an admin approves who
	# enters (ADR 0007). OAuth callbacks and webhooks (V1C-85) get exact paths, never /api/* whole.
	reverse_proxy web:3000
}

# Chatwoot (ADR 0009): its own login, its own subdomain (Rails cannot live under a path). Routed
# only after the super admin exists, because its installation onboarding is first come, first
# served. WebSockets (/cable) pass through reverse_proxy as is.
{$CHATWOOT_DOMAIN} {
	encode zstd gzip
	import security_headers
	reverse_proxy chatwoot:3000
}
