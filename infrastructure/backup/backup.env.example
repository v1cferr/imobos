# /etc/imobos/backup.env (root, mode 600). NAMES only here: the repository is public.
# Cloudflare R2 through restic's S3 backend: s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>
RESTIC_REPOSITORY=
# Encrypts every snapshot. Also in the password manager: without it the backup is unrecoverable.
RESTIC_PASSWORD=
# R2 API token (S3 credentials), scoped to the backup bucket only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# healthchecks.io ping URL (https://hc-ping.com/<uuid>). Empty disables the alarm.
HC_PING_URL=
