# ImobOS environment. Copy to .env (git-ignored) and fill in; never commit real values.
# The repository is public: this file documents NAMES only. Empty values are required:
# `docker compose` refuses to start while any of them is missing.

# Container timezone (logs, schedules). Defaults to America/Sao_Paulo when unset.
TZ=America/Sao_Paulo

# --- Edge (caddy) ---
# Public hostname. Its DNS A record must point at this host for the TLS certificate to issue.
IMOBOS_DOMAIN=
# Contact for the ACME (Let's Encrypt) account: expiry and policy notices.
ACME_EMAIL=

# --- Authentication (web, ADR 0006): Google identifies WHO signs in, nothing else ---
# Encrypts the session cookie. 32+ random bytes: `openssl rand -base64 33`. Rotating it signs
# everyone out.
AUTH_SECRET=
# OAuth client (Web application) whose ONLY redirect URI in production is
# https://<IMOBOS_DOMAIN>/api/auth/callback/google. Kept in the password manager.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Bootstrap admins (comma-separated Google emails, required): always approved admins, so the
# approval screen can never be locked. Everyone else signs up and waits for approval (ADR 0007).
IMOBOS_ADMIN_EMAILS=
# Whether unknown Google accounts may request access. Close it once the expected users are in.
IMOBOS_SIGNUP_OPEN=true
# Spam guard: new requests are refused while this many are waiting.
IMOBOS_MAX_PENDING=10
# Shared secret between web and api for /internal/* (`openssl rand -hex 32`). Never routed by Caddy.
INTERNAL_API_TOKEN=

# --- Connected accounts (api, ADR 0008); empty values leave integrations unavailable ---
# Fernet keys that encrypt integration tokens, comma-separated, newest first (older ones only
# decrypt, for rotation). Generate: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep them in the password manager: the database backup is useless for tokens without them.
IMOBOS_TOKEN_KEYS=
# Google OAuth client "ImobOS integrações" (Web application), separate from the login client.
# Redirect URI: https://<IMOBOS_DOMAIN>/api/integrations/google-calendar/callback
GOOGLE_INTEGRATIONS_CLIENT_ID=
GOOGLE_INTEGRATIONS_CLIENT_SECRET=

# --- Data (postgres, redis): reachable only from the api, on an internal network ---
POSTGRES_USER=imobos
POSTGRES_DB=imobos
# Generate on the host, e.g. `openssl rand -base64 32 | tr -d '/+='`; it never leaves it.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
