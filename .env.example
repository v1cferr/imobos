# ImobOS environment. Copy to .env (git-ignored) and fill in; never commit real values.
# The repository is public: this file documents NAMES only. Empty values are required:
# `docker compose` refuses to start while any of them is missing.

# Container timezone (logs, schedules). Defaults to America/Sao_Paulo when unset.
TZ=America/Sao_Paulo

# --- Edge (caddy) ---
# Public hostname. Its DNS A record must point at this host for the TLS certificate to issue.
IMOBOS_DOMAIN=
# Contact for the ACME (Let's Encrypt) account: expiry and policy notices.
ACME_EMAIL=
# Site-wide basic auth until the application has its own login.
BASIC_AUTH_USER=
# bcrypt hash, never the password:  docker run --rm caddy:2.11.6-alpine caddy hash-password
# Keep the SINGLE QUOTES: the hash contains `$`, which Compose would otherwise interpolate.
BASIC_AUTH_HASH=''

# --- Data (postgres, redis): reachable only from the api, on an internal network ---
POSTGRES_USER=imobos
POSTGRES_DB=imobos
# Generate on the host, e.g. `openssl rand -base64 32 | tr -d '/+='`; it never leaves it.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
